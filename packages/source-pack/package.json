{
  "name": "@third-chair/source-pack",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "source-pack": "node --conditions=development --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@third-chair/contracts": "0.2.1",
    "zod": "^4.0.0"
  }
}
